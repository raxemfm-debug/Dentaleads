DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dentalbot
DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@localhost:5432/dentalbot
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
JWT_SECRET=
ENVIRONMENT=development

# Optional. Seconds after which an inbound WhatsApp message is treated as a stale
# redelivery and dropped without processing (default 900 = 15 min).
# WEBHOOK_MAX_MESSAGE_AGE_SECONDS=900

# Optional. Async Postgres DSN for the real-concurrency double-booking test
# (backend/tests/test_appointment_race_postgres.py) — point it at a dedicated
# test database with migrations applied (`alembic upgrade head`), never at
# the dev database. Test is skipped entirely when unset.
# TEST_POSTGRES_URL=postgresql+asyncpg://user:pass@localhost:5432/dentalbot_test
